cc_binary {
    name: "aera-audio-bridge",
    recovery: true,
    srcs: ["aera_audio_bridge.cpp"],
    static_libs: ["libaera_tinyalsa"],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_library_static {
    name: "libaera_tinyalsa",
    recovery: true,
    srcs: [
        "tinyalsa/src/mixer.c",
        "tinyalsa/src/mixer_hw.c",
        "tinyalsa/src/mixer_plugin.c",
        "tinyalsa/src/pcm.c",
        "tinyalsa/src/pcm_hw.c",
        "tinyalsa/src/pcm_plugin.c",
        "tinyalsa/src/snd_card_plugin.c",
    ],
    local_include_dirs: [
        "tinyalsa/include",
        "tinyalsa/src",
    ],
    export_include_dirs: ["tinyalsa/include"],
    cflags: [
        "-Werror",
        "-Wno-macro-redefined",
    ],
}
