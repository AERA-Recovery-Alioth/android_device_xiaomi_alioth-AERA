cc_binary {
    name: "aera-audio-bridge",
    recovery: true,
    srcs: ["aera_audio_bridge.cpp"],
    static_libs: ["libaera_alioth_tinyalsa"],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

license {
    name: "aera_alioth_tinyalsa_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-BSD-3-Clause"],
    license_text: ["tinyalsa/NOTICE"],
}

cc_library_static {
    name: "libaera_alioth_tinyalsa",
    licenses: ["aera_alioth_tinyalsa_license"],
    recovery: true,
    srcs: [
        "tinyalsa/src/mixer.c",
        "tinyalsa/src/mixer_hw.c",
        "tinyalsa/src/mixer_plugin.c",
        "tinyalsa/src/pcm.c",
        "tinyalsa/src/pcm_hw.c",
        "tinyalsa/src/pcm_plugin.c",
        "tinyalsa/src/snd_card_plugin.c",
    ],
    local_include_dirs: [
        "tinyalsa/include",
        "tinyalsa/src",
    ],
    export_include_dirs: ["tinyalsa/include"],
    cflags: [
        "-Werror",
        "-Wno-macro-redefined",
    ],
}

license {
    name: "aera_alioth_pd_mapper_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-BSD-3-Clause"],
    license_text: ["pd-mapper/LICENSE"],
}
cc_binary {
    name: "aera-alioth-pd-mapper",
    licenses: ["aera_alioth_pd_mapper_license"],
    recovery: true,
    srcs: ["pd-mapper/pd-mapper.cpp", "pd-mapper/assoc.c", "pd-mapper/servreg_loc.c"],
    static_libs: ["libaera_alioth_qrtr", "libjsoncpp"],
    cpp_std: "c++17",
    cflags: ["-D_GNU_SOURCE", "-Wall", "-Wextra", "-Wno-sign-compare", "-Wno-unused-parameter"],
}
