type vendor_alioth_recovery_haptics, fs_type, sysfs_type;

type vendor_alioth_recovery_usb_mode, fs_type, sysfs_type;

# Minimal recovery mount labels, adapted from current Evo Qualcomm legacy-um
# firmware/context-mount and SPU filesystem policy. No ROM HAL grants imported.
