# The recovery Health executable is installed under /system.
type vendor_alioth_recovery_health_exec, exec_type, file_type, system_file_type;

# Read-only factory Wi-Fi provisioning, with no writable calibration access.
type vendor_alioth_recovery_persist_file, file_type, contextmount_type, vendor_file_type;

# System-installed recovery HAL executables.
type vendor_alioth_recovery_allocator_exec, exec_type, file_type, system_file_type;
type vendor_alioth_recovery_supplicant_exec, exec_type, file_type, system_file_type;
type vendor_alioth_recovery_wifi_config_file, file_type;
