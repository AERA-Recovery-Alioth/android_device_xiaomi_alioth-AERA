import /system/etc/init/snapuserd.rc
import /init.recovery.wifi.rc
import /init.recovery.qcom_decrypt.rc

on init && property:ro.aera.selinux.permissive=1
    # Device-configured recovery mode; infrastructure policy checks remain enabled.
    exec u:r:recovery:s0 root root -- /system/bin/setenforce 0

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on post-fs
    start boot-hal-1-1

on boot
    start vendor.health-recovery
    setprop sys.usb.config adb

# GPU buffer allocation must be available before the native AERA renderer.
on init
    mkdir /vendor/lib64/hw 0755 root root
    symlink /system/lib64/android.hardware.graphics.mapper@4.0-impl-qti-display.so /vendor/lib64/hw/android.hardware.graphics.mapper@4.0-impl-qti-display.so
    start aera-graphics-allocator

service aera-graphics-allocator /system/bin/vendor.qti.hardware.display.allocator-service
    class core
    user root
    group root graphics drmrpc
    capabilities SYS_NICE
    seclabel u:r:vendor_alioth_recovery_allocator:s0
